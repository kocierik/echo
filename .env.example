# OpenAI API key (required for STT, LLM, embeddings)
OPENAI_API_KEY=sk-your-key-here

# STT model (default: gpt-4o-transcribe, alternatives: whisper-1, gpt-4o-mini-transcribe)
# STT_MODEL=gpt-4o-transcribe

# STT provider: "openai" (default) or "deepgram"
# STT_PROVIDER=openai

# Deepgram API key (required if STT_PROVIDER=deepgram)
# Get one at https://console.deepgram.com
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# CORS — comma-separated origins (default: * allows all)
# For production, set to your specific domains:
# CORS_ORIGINS=https://echo.example.com,https://app.example.com
CORS_ORIGINS=*

# Circuit breaker — protects against OpenAI outages
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Cloudflare Tunnel (optional, for external access)
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels
# Point the tunnel's public hostname to http://api:8000
CLOUDFLARE_TUNNEL_TOKEN=

# User timezone (IANA name) for relative dates ("domani")
USER_TIMEZONE=Europe/Rome

# Local hour (in USER_TIMEZONE) when the daily digest of the previous day is written
DIGEST_LOCAL_HOUR=4

# Bearer token for Prometheus on /metrics (Authorization: Bearer <token>).
# Without it, /metrics requires a valid X-API-Key.
METRICS_TOKEN=

# Speaker detection: segments with audio energy at or above this percentile of the
# last 100 are "self". Lower it (e.g. 0.3) if your own voice shows as "Someone else".
SPEAKER_THRESHOLD_PERCENTILE=0.7
# Or a fixed energy threshold instead of the percentile (0 = automatic)
# SPEAKER_ENERGY_THRESHOLD=0

# Models: entity extraction, summaries, digest, voice-request check / memory answers and
# the actions agent / the intent check that routes a request to memory or an app
# LLM_ANALYSIS_MODEL=gpt-6-luna
# LLM_QUERY_MODEL=gpt-6-luna
# LLM_INTENT_MODEL=gpt-6-luna
# Reasoning models (gpt-5/gpt-6 families) take an effort instead of a temperature. Function
# tools with reasoning need the Responses API ("responses"); on chat completions only "none".
# Evaluate first: docs/MODEL-EVALUATION.md. Defaults:
# LLM_ANALYSIS_REASONING_EFFORT=low     LLM_ANALYSIS_API=chat
# LLM_QUERY_REASONING_EFFORT=low        LLM_QUERY_API=responses
# LLM_INTENT_REASONING_EFFORT=none      LLM_INTENT_API=chat
# For a non-reasoning model (gpt-4o) set the effort to empty: a temperature is sent instead.

# Web search while answering (weather, news, today's prices): "openai" (the Responses
# API's built-in search, needs LLM_QUERY_API=responses) or "none"; searches per user per day
# WEB_SEARCH_PROVIDER=openai
# WEB_SEARCHES_PER_DAY=30

# Wearable camera: the vision model answering about a photo, and how long a photo request
# waits for the wearable (the user is told in the chat when it never arrives)
# LLM_VISION_MODEL=gpt-6-luna
# PHOTO_REQUEST_TIMEOUT_S=90

# Composio project API key (ak_..., not the MCP consumer key ck_...): enables actions on
# Gmail, Calendar, Slack, ... After changing .env: docker compose up -d --force-recreate api worker
COMPOSIO_API_KEY=

# Anyone with the app can create an account; false closes it (accounts then only with
# make create-user). Restart the api after changing it.
REGISTRATION_OPEN=true
